rules_version = '2';

// Every daily summary and workout lives under users/{uid}/... (see
// app/src/main/java/com/fitnessapp/summary/sync/FirestoreSyncManager.kt).
// A signed-in user can only ever read or write documents under their OWN
// uid - Firebase Auth (Google Sign-In) is what proves who they are, so
// there's no separate password/URL/key to manage or leak.
//
// This matters more here than in a habits app: these documents are health
// data - resting heart rate, sleep, training sessions.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
