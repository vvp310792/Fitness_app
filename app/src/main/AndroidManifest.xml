<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Networking - Firebase (Firestore + Auth) and the GitHub update checker -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Lets the app trigger the system installer to apply a downloaded update APK -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      Health Connect read permissions. Every one of these is READ-only on purpose:
      this app never writes a single record back, it only summarises what Garmin
      Connect (or any other source) already put into Health Connect. Each one maps
      to a record type in health/HealthConnectManager.kt - keep the two lists in
      sync, since a permission requested in code but missing here is silently
      never granted.
    -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <!--
      Without this, Health Connect only ever hands back the last 30 days no matter
      what time range we ask for - which would quietly cap the app's history.
    -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_HISTORY" />

    <!--
      Required so the app can see (and deep-link into) the Health Connect app on
      Android 13 and below, where it's a separately installed APK rather than part
      of the system. Package visibility filtering hides it otherwise.
    -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <intent>
            <action android:name="androidx.health.ACTION_SHOW_HEALTH_CONNECT_SETTINGS" />
        </intent>
    </queries>

    <application
        android:name=".FitnessSummaryApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FitnessSummary">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.FitnessSummary">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Android 13 and below: Health Connect (the standalone APK) opens this
              when the user taps "read the app's privacy policy" in its permission
              sheet. Without it the permission request is rejected outright.
            -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!--
          Android 14+: the same rationale hook, but the platform looks for it as a
          VIEW_PERMISSION_USAGE activity in the HEALTH_PERMISSIONS category instead.
          Both declarations are needed to cover the whole minSdk..targetSdk range.
        -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Exposes the downloaded update APK to the system installer as a content:// URI -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
